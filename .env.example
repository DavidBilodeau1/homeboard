# Home Assistant (required): base URL and a long-lived access token
# (HA → your profile → Security → Long-lived access tokens)
HA_URL=https://homeassistant.example.com
HA_TOKEN=paste-your-token-here

# HomeBoard's own public URL; setting it requires "Log in with Home Assistant".
# Leave empty on a trusted LAN.
PUBLIC_URL=
# SESSION_SECRET=some-long-random-string

# Plugin connections (optional). Each plugin is turned on in Settings → Plugins.
FRIGATE_URL=
# FRIGATE_USER=
# FRIGATE_PASSWORD=
# FRIGATE_TOKEN=

EXPENSAVE_URL=
EXPENSAVE_EMAIL=
EXPENSAVE_PASSWORD=

IMMICH_URL=
IMMICH_API_KEY=
