{
  "locale": "en-US",
  "language": "en",
  "theme": "auto",
  "weatherEntity": "weather.home",
  "calendars": [
    { "entity": "calendar.family", "name": "Family", "color": "#C33C54" },
    { "entity": "calendar.home", "name": "Home", "color": "#4A7DD6" },
    { "entity": "calendar.work", "name": "Work", "color": "#E8A13C" }
  ],
  "tasks": [
    { "name": "Alex", "entity": "todo.alex", "color": "#A9C0F5" },
    { "name": "Sam", "entity": "todo.sam", "color": "#F5AFC0" },
    { "name": "House", "entity": "todo.house", "color": "#A8DFB2" }
  ],
  "meals": [
    { "name": "Menu", "entity": "todo.menu", "color": "#FCE7EC" }
  ],
  "lists": [
    { "name": "Groceries", "entity": "todo.groceries" },
    { "name": "Shopping list", "entity": "todo.shopping_list" }
  ],
  "rewards": [
    { "name": "Alex", "entity": "counter.alex_stars" },
    { "name": "Sam", "entity": "counter.sam_stars" }
  ],
  "people": ["Alex", "Sam"],
  "photos": { "intervalSeconds": 15 },
  "smartHome": {
    "climate": "climate.thermostat",
    "sensors": [
      { "name": "Pool", "entity": "sensor.pool_temperature", "icon": "pool" },
      { "name": "UV", "entity": "sensor.uv_index", "icon": "sun" },
      { "name": "Feels like", "entity": "sensor.feels_like_temperature", "icon": "temp" }
    ],
    "lights": [
      { "name": "Living room", "entity": "light.living_room" },
      { "name": "Kitchen", "entity": "light.kitchen" },
      { "name": "Bedroom", "entity": "light.bedroom" }
    ],
    "locks": [
      { "name": "Front door", "entity": "lock.front_door" }
    ],
    "mediaPlayers": [
      { "name": "Living room", "entity": "media_player.living_room" },
      { "name": "Kitchen", "entity": "media_player.kitchen" }
    ],
    "alarm": "alarm_control_panel.home_alarm"
  },
  "dashboard": {
    "cols": 12,
    "rows": 9,
    "tiles": [
      { "id": "calendar", "x": 0, "y": 0, "w": 3, "h": 9 },
      { "id": "photo", "x": 3, "y": 0, "w": 6, "h": 5 },
      { "id": "tasks", "x": 9, "y": 0, "w": 3, "h": 5 },
      { "id": "weather", "x": 3, "y": 5, "w": 3, "h": 4 },
      { "id": "meals", "x": 6, "y": 5, "w": 3, "h": 4 },
      { "id": "rewards", "x": 9, "y": 5, "w": 3, "h": 4 }
    ]
  },
  "plugins": {
    "frigate": { "enabled": false, "refreshSeconds": 8, "pollSeconds": 15, "alertLimit": 20 },
    "expensave": { "enabled": false, "currency": "USD", "horizonDays": 14, "buffer": 500, "weeklyGoal": 200 },
    "immich": { "enabled": false, "album": "Family" },
    "hockey": { "enabled": false, "entity": "sensor.nhl_mtl" },
    "garbage": {
      "enabled": false,
      "collections": [
        { "name": "Recycling", "entity": "sensor.recycling_schedule", "color": "#4a7dd6" },
        { "name": "Compost", "entity": "sensor.compost_schedule", "color": "#8a5a3b" },
        { "name": "Trash", "entity": "sensor.trash_schedule", "color": "#3d9b63" }
      ]
    },
    "airQuality": { "enabled": false, "entity": "sensor.air_quality_index", "name": "Air quality", "safeMax": 50 },
    "floorPlan": { "enabled": false }
  }
}
